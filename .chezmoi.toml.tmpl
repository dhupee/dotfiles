# chezmoi configuration file
encryption = "age"

# Prompted values are stored in the generated chezmoi config.
{{- $machineRole := promptChoiceOnce . "machineRole" "What role does this machine serve?" (list "personal" "work" "shared" "server" "temporary") "personal" -}}
{{- $personalAssets := promptBoolOnce . "personalAssets" "Deploy personal desktop assets (e.g. Wallpapers)?" (eq $machineRole "personal") -}}
{{- $deployPrivateFiles := promptBoolOnce . "deployPrivateFiles" "Deploy personal private files (SSH keys and secrets)?" false -}}

[add]
    secrets = "ignore"
# You will find the age key in bitwarden's secure note
# Regarding encryption
[age]
    identity = "~/.age-key.txt"
    recipient = "age1g54jf9cl7zfaf60jzg389dng00q933v9hqgsnwnfdktnh7fcc38s26ykfp"
    symmetry = true
[edit]
    command = "nvim"

[data]
    machineRole = {{ $machineRole | quote }}
    personalAssets = {{ $personalAssets }}
    deployPrivateFiles = {{ $deployPrivateFiles }}

{{if eq .chezmoi.os "linux"}}
[merge]
    command = "sh"
    args = [
        ".scripts/bash/chezmoi-merge.sh",
        {{ printf "%q" "{{ .Destination }}" }},
        {{ printf "%q" "{{ .Source }}" }},
        {{ printf "%q" "{{ .Target }}" }},
    ]
{{end}}

{{if eq .chezmoi.os "windows"}}
[hooks.apply.post]
    # command = ".scripts/ps/copy-profile.ps1"
    command = "pwsh"
    args = ["-File",".scripts/ps/copy-profile.ps1"]
{{end}}


