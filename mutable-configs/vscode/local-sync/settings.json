    "editor.defaultFormatter": "ms-python.autopep8",
    "editor.formatOnType": true
  },
  "arduino.useArduinoCli": true,
  "autoDocstring.quoteStyle": "'''",
  "bookmarks.saveBookmarksInProject": true,
  "C_Cpp.clang_format_fallbackStyle": "WebKit",
  "C_Cpp.updateChannel": "Insiders",
  "cmake.configureOnOpen": true,
  "cmake.environment": {
    "PATH": "/home/dhupee/.vscode/extensions/stmicroelectronics.stm32cube-ide-build-cmake-1.46.0-linux-x64/resources/cube-cmake/linux/x86_64:/home/dhupee/.vscode/extensions/stmicroelectronics.stm32cube-ide-core-1.4.0-linux-x64/resources/binaries/linux/x86_64:c:${env.PATH}"
  },
  "containers.enableComposeLanguageService": false,
  "debug.allowBreakpointsEverywhere": true,
  "docker.enableDockerComposeLanguageService": false,
  "editor.bracketPairColorization.enabled": true,
